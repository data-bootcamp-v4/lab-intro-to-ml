





#import libraries
import pandas as pd

import numpy as np
from sklearn.model_selection import train_test_split

from sklearn.neighbors import KNeighborsClassifier


spaceship = pd.read_csv("https://raw.githubusercontent.com/data-bootcamp-v4/data/main/spaceship_titanic.csv")
spaceship.head()





#your code here
spaceship.shape





#your code here
spaceship.dtypes





#your code here
spaceship.isnull().sum()





#your code here

spaceship_cleaned = spaceship.dropna()


spaceship_cleaned.shape








#your code here

# Select only numerical columns
numerical_features = spaceship_cleaned.select_dtypes(include=['float64', 'int64'])

# Check the selected numerical columns
print(numerical_features.head())


numerical_features.shape





#your code here
# target: 'Trasported'

target = spaceship_cleaned['Transported']

print(target.head())


target.shape








#your code here
#  reserve 20% of our data to Test.
X_train, X_test, y_train, y_test = train_test_split(numerical_features, target, test_size=0.20, random_state=0)


X_train.head()


X_test.head()











# This is a classification problem, because the target variable is a boolean (Transported)

# Create an instance of the model
knn = KNeighborsClassifier(n_neighbors=5) # n_neighbors = K





#your code here

# training the model
knn.fit(X_train, y_train)





# make predictions for new data points

pred = knn.predict(X_test)
pred


y_test.values


# Evaluate the model:
print(f"The accuracy of the model is {knn.score(X_test, y_test)*100: .2f}%")



